<Window x:Class="GuiCliGuide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GUI CLI Guide" Width="840" Height="620" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="GUI CLI Guide" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" x:Name="StatusBadge" CornerRadius="12" Background="#E6F4EA" Padding="10,4">
                <TextBlock x:Name="StatusText" Text="Live inspection" Foreground="#0E5B3A" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#F3F5F7" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Hovered control" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="ControlNameText" Text="Waiting for mouse movement..." FontSize="18" TextWrapping="Wrap"/>
                <TextBlock x:Name="ProcessInfoText" Margin="0,8,0,0" FontSize="12" Foreground="#4A4A4A"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Confidence:" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConfidenceText" Text="Medium" FontWeight="Bold" Foreground="#7C3AED"/>
                </StackPanel>

                <Border Grid.Column="1" x:Name="RiskBadge" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" Background="#DBF4E8">
                    <TextBlock x:Name="RiskText" Text="Low" Foreground="#0E5B3A" FontWeight="Bold"/>
                </Border>

                <Button Grid.Column="2" Width="110" Height="34" Margin="12,0,0,0" Click="TogglePause_Click">
                    <TextBlock x:Name="PauseButtonText" Text="Pause"/>
                </Button>

                <Button Grid.Column="3" Width="130" Height="34" Margin="8,0,0,0" Click="ToggleDetails_Click">
                    <TextBlock x:Name="DetailsButtonText" Text="Hide Details"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#FAFAFA" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Likely CLI / API equivalent" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                <TextBox x:Name="CommandTextBox" Grid.Row="1" MinHeight="80" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="14" Margin="0,0,0,12" Background="#111827"
                         Foreground="#F9FAFB" Padding="10"/>

                <TextBlock Grid.Row="2" Text="What may happen behind the GUI" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="ExplanationText" Grid.Row="3" Text="No action detected yet." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"/>

                <Border x:Name="DetailsPanel" Grid.Row="4" Background="#F3F4F6" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Advanced details" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DetailedText" Text="No extra details available yet." TextWrapping="Wrap" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Width="120" Height="34" Margin="0,0,8,0" Click="CopyButton_Click">Copy Example</Button>
            <Button Width="160" Height="34" Margin="0,0,8,0" Click="CopyFullReport_Click">Copy Full Report</Button>
            <Button Width="160" Height="34" Click="ToggleAlwaysOnTop_Click">Toggle Always On Top</Button>
        </StackPanel>
    </Grid>
</Window>
